{
  "name": "astro-mfd",
  "private": true,
  "version": "0.0.11",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"yarn dev-client\"",
    "build": "yarn build-client && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build-client": "cd mobile-client && yarn build",
    "dev-client": "cd mobile-client && yarn watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "workspaces": [
    "src",
    "mobile-client",
    "shared"
  ],
  "dependencies": {
    "@common/shared": "*",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "immer": "^10.1.3",
    "konva": "^10.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-konva": "^19.0.10",
    "react-router": "^7.9.3",
    "reactjs-popup": "^2.0.6",
    "svgpath": "^2.6.0",
    "uuid": "^13.0.0",
    "xml-reader": "^2.4.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.8.3",
    "ts-json-schema-generator": "^2.4.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.1"
  }
}
